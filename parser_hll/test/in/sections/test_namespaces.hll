Namespaces:
ns1
	{
	Constants:
		int i := 16;

	Types:
		bool b1;
		bool b2, b3;
		int [0, 100] i1, i2, i3;
		int unsigned 32 i4;
		int signed 8 i5, i6;
		int signed i i7;
		
	types:
		tuple {bool, int, int unsigned 8} t;
		struct {s:bool, v:int signed 16, m:int [0, 360]} st;
		int ^ (i) arr;
		int [0, 9] ^ (3, 3) grid;
		(int [0, 360] * int -> int) conv1;
		(int -> int) conv2;
		ns1::id1 nt1;
		::ns2::id2 nt2;
		sort s;
		sort s < r;
		sort {s1, s2, s3} < r;
		sort ns3::ns4::id3, ::ns5::ns6::id4 < s4;
		enum {e1, e2, e3} en1;
		enum {e4} en2;
	}

namespaces:
ns2
	{
	Constants:
		bool t1 := true;
		bool t2 := TRUE;
		bool t3 := True;
		bool f1 := false;
		bool f2 := FALSE;
		bool f3 := False;
		bool e1 := if f1 then true elif t2 then true else false;
		bool e2 := ~t1;
		bool e3 := t1 & f1;
		bool e4 := f2 # f3;
		bool e5 := t2 #! t3;
		bool e6 := e1 -> e4;
		bool e7 := e5 <-> e6;
	}